#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

: "${OPENCODE_HOSTNAME:=127.0.0.1}"
: "${OPENCODE_PORT:=4096}"
: "${OPENCHAMBER_PORT:=3000}"
: "${OPENCHAMBER_OPENCODE_HOSTNAME:=$OPENCODE_HOSTNAME}"
: "${OPENCHAMBER_OPENCODE_PORT:=$OPENCODE_PORT}"
: "${OPENCODE_READY_TIMEOUT:=60}"

if [[ ! "$OPENCHAMBER_PORT" =~ ^[1-9][0-9]{0,4}$ ]] || ((OPENCHAMBER_PORT > 65535)); then
  echo "Error: OPENCHAMBER_PORT must be an integer between 1 and 65535." >&2
  exit 2
fi

if ! command -v openchamber >/dev/null 2>&1; then
  echo "Error: openchamber is not installed or not on PATH." >&2
  exit 1
fi

log_dir="$HOME/.local/state/opencode-openchamber"
mkdir -p "$log_dir"

OPENCHAMBER_PID_FILE="$log_dir/openchamber.pid"
rm -f "$OPENCHAMBER_PID_FILE"

cleanup() {
  # Stopping OpenChamber also stops the OpenCode server it manages.
  if [[ -f "$OPENCHAMBER_PID_FILE" ]]; then
    openchamber stop --port "$OPENCHAMBER_PORT" >>"$log_dir/openchamber.log" 2>&1 || true
    rm -f "$OPENCHAMBER_PID_FILE"
  fi
}

trap cleanup EXIT INT TERM

# OpenChamber starts and restarts OpenCode (e.g. for updates) on a fixed address
# with a fixed password, so the TUI can reconnect after every restart.
OPENCODE_SERVER_PASSWORD="$(head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '=\n')"
export OPENCODE_SERVER_PASSWORD
export OPENCODE_PASSWORD="$OPENCODE_SERVER_PASSWORD"
export OPENCHAMBER_OPENCODE_HOSTNAME
export OPENCHAMBER_OPENCODE_PORT

opencode_url="http://${OPENCHAMBER_OPENCODE_HOSTNAME}:${OPENCHAMBER_OPENCODE_PORT}"

openchamber --lan --port "$OPENCHAMBER_PORT" >"$log_dir/openchamber.log" 2>&1
touch "$OPENCHAMBER_PID_FILE"
echo "OpenChamber started on port ${OPENCHAMBER_PORT}. Logs: $log_dir/openchamber.log" >&2

# The daemon returns before OpenCode is up, and the TUI gives up if it cannot connect.
echo "Waiting for OpenCode at ${opencode_url}..." >&2
deadline=$((SECONDS + OPENCODE_READY_TIMEOUT))
until curl -fs --max-time 2 -o /dev/null -u "opencode:${OPENCODE_SERVER_PASSWORD}" "${opencode_url}/api/info"; do
  if ((SECONDS >= deadline)); then
    echo "Error: OpenCode did not become ready at ${opencode_url}. See $log_dir/openchamber.log" >&2
    exit 1
  fi
  sleep 0.5
done

opencode --server "$opencode_url" "$@"
